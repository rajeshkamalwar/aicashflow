# Copy to /etc/aicashflow/aicashflow.env, restrict to root, and replace every placeholder.
AI_CASHFLOW_ENV=production
AI_CASHFLOW_DEV_AUTH_BYPASS=false
AI_CASHFLOW_TRUSTED_PROXIES=127.0.0.1/32,::1/128
AI_CASHFLOW_PROXY_ASSERTION_SECRET=<minimum-32-random-bytes>
AI_CASHFLOW_ADMIN_USERS=<case-sensitive-basic-auth-username>
AI_CASHFLOW_API_KEY=<minimum-32-random-bytes>
AI_CASHFLOW_API_KEY_PREVIOUS=
AI_CASHFLOW_MASTER_KEY=<valid-fernet-key>
AI_CASHFLOW_DATABASE_PATH=/var/lib/aicashflow/operations.sqlite3
AI_CASHFLOW_PUBLIC_ORIGIN=https://www.aicashflow.pro
AI_CASHFLOW_MAX_UPLOAD_BYTES=10485760
AI_CASHFLOW_SAMPLES_DIR=/var/lib/aicashflow/samples
AI_CASHFLOW_REPORTS_DIR=/var/lib/aicashflow/reports
AI_CASHFLOW_TENANT_CONFIG_PATH=/var/lib/aicashflow/config/tenant.local.json
# Used only by the secret-safe post-deploy smoke check; format: username:password
AI_CASHFLOW_SMOKE_BASIC_AUTH=<approved-basic-auth-user-and-password>
# Non-secret application source identifier used by the financial API smoke check.
AI_CASHFLOW_SMOKE_SOURCE_ID=<approved-amazon-source-id>
